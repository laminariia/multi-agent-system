# MAS Production Environment Variables
# Copy to .env and fill in real values
#
# Railway auto-injects DATABASE_URL and VALKEY_URL when PostgreSQL
# and Valkey services are linked. Override below only for non-Railway deploys.

# ── Database (auto-injected by Railway) ─────────────────────────────
# DATABASE_URL=postgresql://...  (provided by Railway PostgreSQL plugin)
# VALKEY_URL=valkey://...        (provided by Railway Valkey plugin)

# ── LLM APIs (OpenRouter) ────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Legacy per-provider keys (optional)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Sandbox ───────────────────────────────────────────────────────────
E2B_API_KEY=

# ── Freelance Platforms ───────────────────────────────────────────────
FREELANCER_CLIENT_ID=
FREELANCER_CLIENT_SECRET=

# ── Enrichment ────────────────────────────────────────────────────────
HUNTER_API_KEY=
APOLLO_API_KEY=

# ── Proxy (BrightData) ───────────────────────────────────────────────
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
BRIGHTDATA_HOST=brd.superproxy.io

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# ── Notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
LANGSMITH_API_KEY=

# ── Application ──────────────────────────────────────────────────────
APP_VERSION=4.2.0
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["https://your-domain.up.railway.app"]

# ── CI/CD ─────────────────────────────────────────────────────────────
# RAILWAY_TOKEN — add to GitHub Secrets for deploy workflow
