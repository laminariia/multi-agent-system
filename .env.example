# ==================== DATABASE ====================
DATABASE_URL=postgresql://mas:mas_password@localhost:5432/mas
VALKEY_URL=valkey://localhost:6379

# ==================== LLM (OpenRouter — single key for all models) ====================
OPENROUTER_API_KEY=             # Get from https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==================== SANDBOX ====================
# E2B_API_KEY=                  # For quick tests only (<5 min)

# ==================== FREELANCE PLATFORMS ====================
# FREELANCER_CLIENT_ID=
# FREELANCER_CLIENT_SECRET=

# ==================== ENRICHMENT ====================
# HUNTER_API_KEY=
# APOLLO_API_KEY=

# ==================== PROXY ====================
# BRIGHTDATA_USERNAME=
# BRIGHTDATA_PASSWORD=
# BRIGHTDATA_HOST=brd.superproxy.io

# ==================== AUTH ====================
JWT_SECRET_KEY=                 # Generate: openssl rand -hex 32
ENCRYPTION_KEY=                 # Fernet key for credentials encryption

# ==================== NOTIFICATIONS ====================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ==================== MONITORING ====================
# LANGSMITH_API_KEY=            # LLM tracing
# SENTRY_DSN=                   # Error tracking

# ==================== HEARTBEAT ====================
# HEARTBEAT_INTERVAL_SECONDS=90      # Agent ping interval
# HEARTBEAT_TIMEOUT_SECONDS=180      # Timeout before restart
# HEARTBEAT_MAX_RESTARTS=3           # Max restarts before HITL alert
# HEARTBEAT_MONITOR_POLL_SECONDS=30  # Monitor check interval

# ==================== SEMANTIC CACHE ====================
# SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92  # Cosine similarity threshold
# SEMANTIC_CACHE_TTL_PROPOSAL=86400         # Proposal cache: 24h
# SEMANTIC_CACHE_TTL_CODE=3600              # Code cache: 1h
# SEMANTIC_CACHE_TTL_CONTENT=43200          # Content cache: 12h
# SEMANTIC_CACHE_TTL_TRANSLATION=604800     # Translation cache: 7d
# SEMANTIC_CACHE_TTL_DEFAULT=21600          # Default cache: 6h
