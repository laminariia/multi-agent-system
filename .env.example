# ==================== PRODUCTION ====================
POSTGRES_PASSWORD=mas_password
POSTGRES_USER=mas                            # default: mas
POSTGRES_DB=mas                              # default: mas
PUBLIC_URL=http://localhost                   # Public URL for dashboard, no trailing slash

# ==================== DATABASE ====================
DATABASE_URL=postgresql://mas:mas_password@localhost:5432/mas
VALKEY_URL=valkey://default:changeme@localhost:6379
VALKEY_PASSWORD=changeme

# ==================== LLM (OpenRouter — single key for all models) ====================
OPENROUTER_API_KEY=             # Get from https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==================== EMBEDDINGS (OpenAI direct) ====================
OPENAI_API_KEY=                 # OpenAI — used for text-embedding-3-large (3072 dim)

# ==================== SANDBOX ====================
# E2B_API_KEY=                  # For quick tests only (<5 min)

# ==================== FREELANCE PLATFORMS ====================
# FREELANCER_CLIENT_ID=
# FREELANCER_CLIENT_SECRET=

# ==================== ENRICHMENT ====================
# HUNTER_API_KEY=
# APOLLO_API_KEY=

# ==================== PROXY ====================
# BRIGHTDATA_USERNAME=
# BRIGHTDATA_PASSWORD=
# BRIGHTDATA_HOST=brd.superproxy.io

# ==================== AUTH ====================
JWT_SECRET_KEY=                 # Generate: openssl rand -hex 32
ENCRYPTION_KEY=                 # Fernet key for credentials encryption
ADMIN_EMAIL=                    # Auto-seed first admin user
ADMIN_PASSWORD=                 # Auto-seed first admin password

# ==================== NOTIFICATIONS ====================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ==================== MONITORING ====================
# LANGSMITH_API_KEY=            # LLM tracing
# SENTRY_DSN=                   # Error tracking
GRAFANA_ADMIN_PASSWORD=admin    # Change in production!

# ==================== TELEGRAM CHANNEL MONITORING (Telethon) ====================
# TELEGRAM_API_ID=                # Get from https://my.telegram.org/apps
# TELEGRAM_API_HASH=              # Get from https://my.telegram.org/apps
# TELEGRAM_SESSION_STRING=        # Generated via scripts/generate_telegram_session.py

# ==================== TELEGRAM DM OUTREACH ====================
# TELEGRAM_DM_MAX_PER_HOUR=5                    # Max DMs per hour (anti-ban)
# TELEGRAM_DM_MIN_INTERVAL_SECONDS=720           # 12 minutes between DMs

# ==================== HEARTBEAT ====================
# HEARTBEAT_INTERVAL_SECONDS=90      # Agent ping interval
# HEARTBEAT_TIMEOUT_SECONDS=180      # Timeout before restart
# HEARTBEAT_MAX_RESTARTS=3           # Max restarts before HITL alert
# HEARTBEAT_MONITOR_POLL_SECONDS=30  # Monitor check interval

# ==================== SEMANTIC CACHE ====================
# SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92  # Cosine similarity threshold
# SEMANTIC_CACHE_TTL_PROPOSAL=86400         # Proposal cache: 24h
# SEMANTIC_CACHE_TTL_CODE=3600              # Code cache: 1h
# SEMANTIC_CACHE_TTL_CONTENT=43200          # Content cache: 12h
# SEMANTIC_CACHE_TTL_TRANSLATION=604800     # Translation cache: 7d
# SEMANTIC_CACHE_TTL_DEFAULT=21600          # Default cache: 6h

# ==================== SCHEDULER ====================
# SCOUT_INTERVAL_MINUTES=5                    # Scout cycle frequency
# METRICS_INTERVAL_SECONDS=60                 # Metrics collection frequency
# HEARTBEAT_CLEANUP_MINUTES=10                # Stale heartbeat cleanup frequency
# PIPELINE_B_SCAN_INTERVAL_HOURS=24           # Pipeline B geo-scan frequency
# PIPELINE_B_CITIES=                          # Comma-separated city names, e.g. "Berlin,Munich,Hamburg"

# ==================== EMAIL / SMTP (Pipeline B Outreach) ====================
# SMTP_HOST=                               # e.g. smtp.gmail.com
# SMTP_PORT=587                            # TLS port
# SMTP_USER=                               # SMTP login
# SMTP_PASSWORD=                           # SMTP password
# SMTP_FROM=                               # Sender "From" address
# MAX_EMAILS_PER_DAY=50                    # Daily rate limit
# EMAIL_STAGGER_MIN_SECONDS=30             # Min delay between sends (anti-spam)
# EMAIL_STAGGER_MAX_SECONDS=60             # Max delay between sends (anti-spam)
# EMAIL_HTML_ENABLED=true                  # Send HTML+text multipart emails
